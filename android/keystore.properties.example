# Release signing config — copy to `android/keystore.properties` and fill in.
# This file (the .example) is committed; keystore.properties and *.jks are NOT.
#
# Generate an upload key (run from the android/ directory):
#   keytool -genkey -v -keystore upload-keystore.jks -keyalg RSA -keysize 2048 \
#           -validity 10000 -alias upload
#
# Then enroll in Play App Signing (recommended): upload this key as your *upload*
# key; Google holds the app signing key. Put the upload key's SHA-256 fingerprint
# into public/.well-known/assetlinks.json for App Links.
#   keytool -list -v -keystore upload-keystore.jks -alias upload   # shows SHA-256

storeFile=upload-keystore.jks
storePassword=CHANGEME
keyAlias=upload
keyPassword=CHANGEME
