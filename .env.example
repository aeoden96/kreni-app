# Copy to .env.local and fill in. All values are optional for a basic run:
# `yarn dev` proxies the static GTFS dataset from production automatically
# (see vite.config.ts), so the map works with live data out of the box.

# Realtime proxy Worker (GTFS-RT, nextbike, road closures, announcements).
# Leave blank to run without realtime, or point at the public production worker:
#   VITE_GTFS_PROXY_URL=https://api.kreni.app
VITE_GTFS_PROXY_URL=

# Base URL for the extra static datasets (galleries, graffiti, etc.).
# Defaults to https://data.kreni.app when unset.
# VITE_STATIC_DATA_URL=https://data.kreni.app

# Optional: API key, only if the worker is configured with key-based auth.
# VITE_GTFS_API_KEY=

# Optional: Tally feedback form ID (Tally → Publish → Share → Form ID).
# VITE_TALLY_FEEDBACK_FORM_ID=
