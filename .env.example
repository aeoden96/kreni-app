# URL of your deployed Cloudflare Worker (kreni-app-worker).
# Example: https://zet-gtfs-proxy.<your-subdomain>.workers.dev
# Used for: GTFS-RT, nextbike, global announcement, and Driving mode road closures (/road-closures).
VITE_GTFS_PROXY_URL=

OLLAMA_API_KEY=

# Optional: API key (not needed for local dev)
# VITE_GTFS_API_KEY=


# Optional: API key if you've configured key-based auth on the worker
# VITE_GTFS_API_KEY=

# Tally feedback form ID (from Tally → Publish → Share → Form ID)
# VITE_TALLY_FEEDBACK_FORM_ID=
