{
  "name": "kreni-app",
  "private": true,
  "version": "3.6.1",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "dev": "vite",
    "dev:host": "vite --host",
    "prebuild": "node scripts/generate-changelog.js",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:storybook": "vitest run --project storybook",
    "test:ui": "vitest --ui --project unit",
    "tsc": "tsc -b --noEmit",
    "test:coverage": "vitest --coverage",
    "test:e2e": "docker compose -f docker-compose.playwright.yml run --rm playwright-runner",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "pw:server": "docker compose -f docker-compose.playwright.yml up playwright-server",
    "pw:server:down": "docker compose -f docker-compose.playwright.yml down playwright-server",
    "knip": "knip",
    "screenshots": "node scripts/play-screenshots.mjs",
    "verify:live": "vitest run --project live",
    "verify:trip-drift": "node scripts/verify-trip-drift.mjs",
    "sample:trip-drift": "node scripts/sample-trip-drift.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "secret": "git ls-files | xargs secretlint"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "secretlint",
      "prettier --write"
    ],
    "*.{json,css,md,html}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@capacitor-firebase/messaging": "^8",
    "@capacitor/app": "^8",
    "@capacitor/core": "^8.4.2",
    "@capacitor/geolocation": "^8",
    "@capacitor/haptics": "^8",
    "@capacitor/local-notifications": "^8",
    "@capacitor/network": "^8",
    "@capacitor/share": "^8",
    "@capacitor/splash-screen": "^8",
    "@capacitor/status-bar": "^8",
    "@tanstack/react-query": "^5.101.4",
    "firebase": "^12",
    "gtfs-realtime-bindings": "^1.1.1",
    "i18next": "^25.10.10",
    "idb-keyval": "^6.3.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.577.0",
    "papaparse": "^5.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^16.6.6",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.1",
    "supercluster": "^8.0.1",
    "zustand": "^5.0.14"
  },
  "resolutions": {
    "rollup": ">=4.59.0",
    "serialize-javascript": ">=7.0.3",
    "underscore": ">=1.13.8",
    "flatted": ">=3.4.2",
    "tar": ">=7.5.16",
    "uuid": ">=11.1.1",
    "minimatch": ">=3.1.3"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.62.0",
    "@secretlint/secretlint-rule-preset-recommend": "^11.7.1",
    "@storybook/addon-a11y": "^10.5.5",
    "@storybook/addon-docs": "^10.5.5",
    "@storybook/addon-onboarding": "^10.5.5",
    "@storybook/addon-vitest": "^10.5.5",
    "@storybook/react-vite": "^10.5.5",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^24.13.3",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/supercluster": "^7.1.3",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/browser-playwright": "4.1.10",
    "@vitest/coverage-v8": "4.1.10",
    "@vitest/ui": "^4.1.10",
    "branch-name-lint": "^3.0.1",
    "daisyui": "^5.7.4",
    "eslint": "10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-perfectionist": "^5.10.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "fake-indexeddb": "^6.2.5",
    "geojson": "^0.5.0",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jsdom": "^27.4.0",
    "knip": "^5.88.1",
    "lint-staged": "^16.4.0",
    "playwright": "^1.58.2",
    "prettier": "^3.9.6",
    "secretlint": "^11.7.1",
    "storybook": "^10.5.5",
    "tailwindcss": "^4.0.9",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
