{
  "name": "kreni-app",
  "private": true,
  "version": "1.5.2",
  "license": "MIT",
  "type": "module",
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "dev": "vite",
    "dev:host": "vite --host",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "tsc": "tsc -b --noEmit",
    "test:coverage": "vitest --coverage",
    "test:e2e": "docker compose -f docker-compose.playwright.yml run --rm playwright-runner",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "pw:server": "docker compose -f docker-compose.playwright.yml up playwright-server",
    "pw:server:down": "docker compose -f docker-compose.playwright.yml down playwright-server",
    "knip": "knip",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "gtfs-realtime-bindings": "^1.1.1",
    "idb-keyval": "^6.2.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.577.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.13.1",
    "zustand": "^5.0.11"
  },
  "resolutions": {
    "rollup": ">=4.59.0",
    "serialize-javascript": ">=7.0.3",
    "underscore": ">=1.13.8",
    "ajv": "^6.14.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "1.58.2",
    "@tailwindcss/typography": "^0.5.16",
    "@tailwindcss/vite": "^4.2.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/ui": "^4.0.18",
    "daisyui": "^5.5.19",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "geojson": "^0.5.0",
    "globals": "^16.5.0",
    "jsdom": "^27.4.0",
    "knip": "^5.86.0",
    "tailwindcss": "^4.0.9",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.0.18",
    "storybook": "^10.2.19",
    "@storybook/react-vite": "^10.2.19",
    "@chromatic-com/storybook": "^5.0.1",
    "@storybook/addon-vitest": "^10.2.19",
    "@storybook/addon-a11y": "^10.2.19",
    "@storybook/addon-docs": "^10.2.19",
    "@storybook/addon-onboarding": "^10.2.19",
    "playwright": "^1.58.2",
    "@vitest/browser-playwright": "4.0.18",
    "@vitest/coverage-v8": "4.0.18"
  }
}
